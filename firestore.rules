rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents stored at users/{userId}
    match /users/{userId} {
      // Unauthenticated users cannot read or write private profiles
      // An authenticated user can only read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // An authenticated user can only create their own document matching their UID
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == userId
        && isValidProfileData(request.resource.data);

      // An authenticated user can only update their own document
      // Cannot alter immutable fields (uid, createdAt)
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == userId
        && isValidProfileData(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']));

      // Disallow user profile document deletion from client
      allow delete: if false;

      // Cloud resume documents stored at users/{userId}/resumes/{resumeId}
      match /resumes/{resumeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Resume setup wizard documents stored at users/{userId}/resumeSetups/{setupId}
      match /resumeSetups/{setupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy setup collection aliases for backward compatibility
      match /resume_setup/{setupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /resumeSetup/{setupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Resume review documents stored at users/{userId}/resumeReviews/{reviewId}
      match /resumeReviews/{reviewId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ATS analysis reports stored at users/{userId}/atsReports/{reportId}
      match /atsReports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Owner-scoped ATS documents stored under users/{userId}/ats/{document=**}
      match /ats/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Career intelligence documents stored at users/{userId}/careerIntelligence/{careerPlanId}
      match /careerIntelligence/{careerPlanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Interview sessions stored at users/{userId}/interviewSessions/{sessionId}
      match /interviewSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Interview topic progress stored at users/{userId}/interviewProgress/{progressId}
      match /interviewProgress/{progressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Saved interview plans stored at users/{userId}/interviewPlans/{planId}
      match /interviewPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase 7: Saved jobs stored at users/{userId}/savedJobs/{jobId}
      match /savedJobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase 7: Applications tracked at users/{userId}/applications/{applicationId}
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase 7: Job match analyses stored at users/{userId}/jobMatches/{matchId}
      match /jobMatches/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase 7: Application drafts stored at users/{userId}/applicationDrafts/{draftId}
      match /applicationDrafts/{draftId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase D.6: Career Roadmap stored at users/{userId}/careerRoadmap/{roadmapId}
      match /careerRoadmap/{roadmapId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase D.7.1: AI Assistant conversations stored at users/{userId}/aiConversations/{conversationId}
      match /aiConversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase D.7.2: Personalization & Student Goals stored at users/{userId}/personalization/{goalDocId}
      match /personalization/{goalDocId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Helper function to validate allowed fields and types for user profiles
    function isValidProfileData(data) {
      // Restrict fields to permitted user profile fields only
      let allowedKeys = [
        'uid', 'displayName', 'email', 'emailVerified', 'photoURL',
        'avatar', 'collegeOrUniversity', 'major', 'graduationYear',
        'gpa', 'targetRole', 'bio', 'phone', 'location',
        'socialLinks', 'createdAt', 'updatedAt', 'onboardingCompleted'
      ];
      
      return data.keys().hasOnly(allowedKeys)
        && (data.uid is string)
        && (!('displayName' in data) || data.displayName == null || data.displayName is string)
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('photoURL' in data) || data.photoURL == null || data.photoURL is string)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
